#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "Kernels.glsl"
#include "SphPush.glsl"

layout(local_size_x = 64) in;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const GpuSimParams p = pc.params.p;
  if (i >= p.particleCount) {
    return;
  }

  Particle self = pc.particles.particles[i];
  if (self.flags != ParticleFlagFluid) {
    return;
  }

  const ivec3 center = CellCoords(self.position, p);
  vec3 correction = vec3(0.0);

  for (int z = -1; z <= 1; ++z) {
    for (int y = -1; y <= 1; ++y) {
      for (int x = -1; x <= 1; ++x) {
        const ivec3 cell = center + ivec3(x, y, z);
        if (any(lessThan(cell, ivec3(0))) || any(greaterThanEqual(cell, ivec3(p.gridSize)))) {
          continue;
        }
        const uint linear = CellIndex(cell, p);
        const uint begin = pc.offsets.data[linear];
        const uint end = begin + pc.counts.data[linear];
        for (uint j = begin; j < end; ++j) {
          if (j == i) {
            continue;
          }
          const Particle other = pc.particles.particles[j];
          const vec3 grad = SpikyGradient(self.position - other.position, p.kernelRadius);
          correction -= other.mass * (self.kappa + other.kappa) * grad;
        }
      }
    }
  }

  self.velocity += correction * p.dt;
  pc.particles.particles[i] = self;
}
