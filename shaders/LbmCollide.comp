#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "Wind.glsl"

layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform PushConstants {
  LbmRW src;
  LbmRW dst;
  OccupancyRW occupancy;
  MacroRW macro;
  ParticleRW tracers;
  uvec3 grid;
  uint cellCount;
  float tau;
  float inletUx;
  uint tracerCount;
  uint seed;
  vec3 origin;
  float cellSize;
};

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= cellCount) {
    return;
  }
  const uint occ = occupancy.data[i];
  LbmPop pop = src.cells[i];
  if (occ == WindSolid || occ == WindWall) {
    dst.cells[i] = pop;
    macro.values[i] = vec4(1.0, 0.0, 0.0, 0.0);
    return;
  }

  float density = 0.0;
  vec3 momentum = vec3(0.0);
  for (uint k = 0; k < LbmQ; ++k) {
    density += pop.f[k];
    momentum += pop.f[k] * vec3(kLbmE[k]);
  }
  density = max(density, 1.0e-5);
  vec3 velocity = momentum / density;
  if (occ == WindInlet) {
    density = 1.0;
    velocity = vec3(inletUx, 0.0, 0.0);
  }
  const float invTau = 1.0 / tau;
  for (uint k = 0; k < LbmQ; ++k) {
    const float feq = LbmFeq(k, density, velocity);
    pop.f[k] += (feq - pop.f[k]) * invTau;
  }
  dst.cells[i] = pop;
  macro.values[i] = vec4(density, velocity);
}
