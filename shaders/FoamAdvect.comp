#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "Kernels.glsl"
#include "SphPush.glsl"

layout(local_size_x = 64) in;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const GpuSimParams p = pc.params.p;
  if (i >= p.foamCapacity) {
    return;
  }

  FoamParticle foam = pc.foam.particles[i];
  if (foam.alive == 0u) {
    return;
  }

  const float dt = max(p.foamDt, 1.0e-5);
  foam.life -= dt * 1.35;
  if (foam.life <= 0.0) {
    foam.alive = 0u;
    foam.life = 0.0;
    pc.foam.particles[i] = foam;
    return;
  }

  float drag = 5.5;
  vec3 gravity = p.gravity;
  if (foam.position.y < p.domainMin.y + 0.10) {
    gravity *= 0.08;
    drag = 14.0;
  }
  foam.velocity += gravity * dt;
  foam.velocity *= max(0.0, 1.0 - drag * dt);
  foam.position += foam.velocity * dt;
  CollideDomain(foam.position, foam.velocity, p.domainMin + vec3(0.008),
                p.domainMax - vec3(0.008), p.restitution);
  pc.foam.particles[i] = foam;
}
