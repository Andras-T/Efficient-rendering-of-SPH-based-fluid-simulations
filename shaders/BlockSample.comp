#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "SphPush.glsl"

layout(local_size_x = 64) in;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const GpuSimParams p = pc.params.p;
  if (i >= p.particleCount || p.blockEnabled < 0.5) {
    return;
  }
  const Particle particle = pc.particles.particles[i];
  if (particle.flags != ParticleFlagFluid) {
    return;
  }
  const vec2 center = 0.5 * (p.blockMin.xz + p.blockMax.xz);
  const vec2 halfXz = 0.5 * (p.blockMax.xz - p.blockMin.xz);
  const vec2 reach = max(halfXz + vec2(p.kernelRadius), vec2(0.28));
  if (any(greaterThan(abs(particle.position.xz - center), reach))) {
    return;
  }
  atomicAdd(pc.overlap.data[0], 1);
}
