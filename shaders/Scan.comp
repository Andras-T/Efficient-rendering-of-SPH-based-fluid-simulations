#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "SphPush.glsl"

layout(local_size_x = 256) in;

shared uint temp[256];

void main() {
  const uint lid = gl_LocalInvocationID.x;
  const uint gid = gl_WorkGroupID.x;
  const uint i = gid * 256u + lid;
  const uint n = pc.params.p.cellCount;
  temp[lid] = i < n ? pc.counts.data[i] : 0u;
  barrier();

  for (uint stride = 1u; stride < 256u; stride *= 2u) {
    const uint addend = lid >= stride ? temp[lid - stride] : 0u;
    barrier();
    temp[lid] += addend;
    barrier();
  }

  if (lid == 0u) {
    pc.blockSums.data[gid] = temp[255];
  }
  if (i < n) {
    pc.offsets.data[i] = lid == 0u ? 0u : temp[lid - 1u];
  }
}
