#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "Kernels.glsl"
#include "SphPush.glsl"

layout(local_size_x = 64) in;

uint Hash(uint x) {
  x ^= x >> 16;
  x *= 0x7feb352du;
  x ^= x >> 15;
  x *= 0x846ca68bu;
  x ^= x >> 16;
  return x;
}

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const GpuSimParams p = pc.params.p;
  if (i >= p.particleCount || p.foamCapacity == 0) {
    return;
  }

  const Particle self = pc.particles.particles[i];
  if (self.flags != ParticleFlagFluid) {
    return;
  }

  const float speed = length(self.velocity);
  const float missing = max(0.0, (p.restDensity - self.density) / max(p.restDensity, 1.0));
  const bool crest = missing > 0.22 && speed > 1.25 && self.density < 0.88 * p.restDensity;
  if (!crest) {
    return;
  }
  if ((Hash(i * 17u + pc.foamSeed) % 21u) != 0u) {
    return;
  }

  const uint h = Hash(i * 747796405u + pc.foamSeed);
  const vec3 jitter = vec3(float(h & 255u), float((h >> 8u) & 255u), float((h >> 16u) & 255u)) /
                          255.0 -
                      0.5;
  for (uint probe = 0; probe < 4u; ++probe) {
    const uint slot = (h + probe * 17u) % p.foamCapacity;
    if (atomicCompSwap(pc.foam.particles[slot].alive, 0u, 1u) == 0u) {
      const float life = mix(0.22, 0.55, float((h >> 4u) & 255u) / 255.0);
      vec3 velocity = self.velocity * 0.28 + jitter * 0.025;
      velocity.y = min(velocity.y, 0.18);
      pc.foam.particles[slot].position = self.position + jitter * (p.kernelRadius * 0.10);
      pc.foam.particles[slot].velocity = velocity;
      pc.foam.particles[slot].life = life;
      return;
    }
  }
}
