#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "Wind.glsl"

layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform PushConstants {
  LbmRW src;
  LbmRW dst;
  OccupancyRW occupancy;
  MacroRW macro;
  ParticleRW tracers;
  uvec3 grid;
  uint cellCount;
  float tau;
  float inletUx;
  uint tracerCount;
  uint seed;
  vec3 origin;
  float cellSize;
};

uint Hash(uint x) {
  x ^= x >> 16;
  x *= 0x7feb352du;
  x ^= x >> 15;
  x *= 0x846ca68bu;
  x ^= x >> 16;
  return x;
}

float Rand01(inout uint state) {
  state = Hash(state);
  return float(state) * (1.0 / 4294967296.0);
}

vec3 SampleVelocity(vec3 world) {
  const vec3 local = (world - origin) / cellSize - vec3(0.5);
  const ivec3 base = ivec3(floor(local));
  const vec3 frac = local - vec3(base);
  vec3 velocity = vec3(0.0);
  float weightSum = 0.0;
  for (int z = 0; z <= 1; ++z) {
    for (int y = 0; y <= 1; ++y) {
      for (int x = 0; x <= 1; ++x) {
        const ivec3 cell = base + ivec3(x, y, z);
        if (any(lessThan(cell, ivec3(0))) || any(greaterThanEqual(cell, ivec3(grid)))) {
          continue;
        }
        const uint occ = occupancy.data[WindCellIndex(uvec3(cell), grid)];
        if (occ == WindSolid || occ == WindWall) {
          continue;
        }
        const float w = ((x == 1) ? frac.x : 1.0 - frac.x) * ((y == 1) ? frac.y : 1.0 - frac.y) *
                        ((z == 1) ? frac.z : 1.0 - frac.z);
        velocity += macro.values[WindCellIndex(uvec3(cell), grid)].yzw * w;
        weightSum += w;
      }
    }
  }
  return weightSum > 1.0e-6 ? velocity / weightSum : vec3(inletUx, 0.0, 0.0);
}

void Respawn(inout Particle particle, uint id) {
  uint state = Hash(id * 747796405u + seed + 1u);
  const vec3 extent = vec3(grid) * cellSize;
  particle.position =
      origin + vec3(cellSize * 1.5, (0.12 + 0.70 * Rand01(state)) * extent.y,
                    (0.12 + 0.76 * Rand01(state)) * extent.z);
  particle.velocity = vec3(inletUx, 0.0, 0.0);
  particle.alpha = 0.4 + 1.6 * Rand01(state);
  particle.flags = ParticleFlagFluid;
}

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= tracerCount) {
    return;
  }
  Particle particle = tracers.particles[i];
  const vec3 extent = vec3(grid) * cellSize;
  const vec3 maxP = origin + extent;
  const vec3 velocity = SampleVelocity(particle.position);
  particle.position += velocity * cellSize * 12.0;
  particle.velocity = velocity;
  particle.alpha -= 0.016;
  const bool outOfTunnel =
      any(lessThan(particle.position, origin + vec3(cellSize))) ||
      any(greaterThan(particle.position, maxP - vec3(cellSize)));
  if (particle.alpha < 0.0 || outOfTunnel) {
    Respawn(particle, i);
  } else {
    const vec3 local = (particle.position - origin) / cellSize;
    const ivec3 cell = ivec3(clamp(floor(local), vec3(0.0), vec3(grid) - vec3(1.0)));
    const uint occ = occupancy.data[WindCellIndex(uvec3(cell), grid)];
    if (occ == WindSolid || occ == WindWall) {
      Respawn(particle, i);
    }
  }
  tracers.particles[i] = particle;
}
