#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "Wind.glsl"

layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform PushConstants {
  LbmRW src;
  LbmRW dst;
  OccupancyRW occupancy;
  MacroRW macro;
  ParticleRW tracers;
  uvec3 grid;
  uint cellCount;
  float tau;
  float inletUx;
  uint tracerCount;
  uint seed;
  vec3 origin;
  float cellSize;
  uint inletNy;
  uint inletNz;
  float trailMix;
};

const int kSubsteps = 8;
const float kRestitution = 0.22;

uint Hash(uint x) {
  x ^= x >> 16;
  x *= 0x7feb352du;
  x ^= x >> 15;
  x *= 0x846ca68bu;
  x ^= x >> 16;
  return x;
}

float Rand01(inout uint state) {
  state = Hash(state);
  return float(state) * (1.0 / 4294967296.0);
}

vec3 SampleVelocity(vec3 world) {
  return WindInterpMacro(macro, occupancy, world, origin, cellSize, grid).yzw;
}

float SampleVorticity(vec3 world) {
  const float h = cellSize;
  const vec3 uxp = SampleVelocity(world + vec3(h, 0.0, 0.0));
  const vec3 uxm = SampleVelocity(world - vec3(h, 0.0, 0.0));
  const vec3 uyp = SampleVelocity(world + vec3(0.0, h, 0.0));
  const vec3 uym = SampleVelocity(world - vec3(0.0, h, 0.0));
  const vec3 uzp = SampleVelocity(world + vec3(0.0, 0.0, h));
  const vec3 uzm = SampleVelocity(world - vec3(0.0, 0.0, h));
  const vec3 curl =
      vec3((uyp.z - uym.z - uzp.y + uzm.y) / (2.0 * h), (uzp.x - uzm.x - uxp.z + uxm.z) / (2.0 * h),
           (uxp.y - uxm.y - uyp.x + uym.x) / (2.0 * h));
  return length(curl);
}

void Respawn(inout Particle particle, uint id) {
  uint state = Hash(id * 747796405u + seed + 17u);
  const uint ny = max(inletNy, 1u);
  const uint nz = max(inletNz, 1u);
  const uint rake = id % (ny * nz);
  const uint iy = rake % ny;
  const uint iz = rake / ny;
  const vec3 extent = vec3(grid) * cellSize;
  const float y01 = clamp((float(iy) + 0.20 + 0.60 * Rand01(state)) / float(ny), 0.0, 1.0);
  const float z01 = clamp((float(iz) + 0.20 + 0.60 * Rand01(state)) / float(nz), 0.0, 1.0);
  const float y = mix(cellSize * 1.12, extent.y - cellSize * 1.12, y01);
  const float z = mix(cellSize * 1.12, extent.z - cellSize * 1.12, z01);
  particle.position = origin + vec3(cellSize * 1.55, y, z);
  particle.velocity = vec3(inletUx, 0.0, 0.0);
  particle.force = particle.position;
  particle.alpha = 0.35 + 2.4 * Rand01(state);
  particle.kappa = 0.0;
  particle.flags = ParticleFlagFluid;
}

bool Blocked(vec3 world) {
  return WindIsBlocked(WindOccupancyAt(occupancy, world, origin, cellSize, grid));
}

void AdvectWithBounce(inout Particle particle, float dt) {
  vec3 pos = particle.position;
  vec3 vel = SampleVelocity(pos);
  if (dot(vel, vel) < 1.0e-10) {
    vel = particle.velocity;
  }
  vec3 next = pos;
  vec3 trial = next;
  trial.x += vel.x * dt;
  if (Blocked(trial)) {
    vel.x = -kRestitution * vel.x;
  } else {
    next.x = trial.x;
  }
  trial = next;
  trial.y += vel.y * dt;
  if (Blocked(trial)) {
    vel.y = -kRestitution * vel.y;
  } else {
    next.y = trial.y;
  }
  trial = next;
  trial.z += vel.z * dt;
  if (Blocked(trial)) {
    vel.z = -kRestitution * vel.z;
  } else {
    next.z = trial.z;
  }
  if (Blocked(next)) {
    vel = -kRestitution * vel;
    next = pos;
  }
  particle.position = next;
  particle.velocity = mix(vel, SampleVelocity(next), 0.65);
}

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= tracerCount) {
    return;
  }
  Particle particle = tracers.particles[i];
  const vec3 extent = vec3(grid) * cellSize;
  const vec3 maxP = origin + extent;
  const float dt = cellSize * 1.15;
  if (Blocked(particle.position)) {
    const vec3 back = particle.position -
                      normalize(particle.velocity + vec3(inletUx, 0.0, 0.0)) * cellSize * 0.45;
    if (Blocked(back)) {
      Respawn(particle, i);
    } else {
      particle.position = back;
      particle.velocity = -kRestitution * particle.velocity;
    }
  }
  for (int s = 0; s < kSubsteps; ++s) {
    AdvectWithBounce(particle, dt);
  }
  particle.force = mix(particle.force, particle.position, trailMix);
  particle.kappa = SampleVorticity(particle.position);
  particle.alpha -= 0.0032;
  const bool leftOutlet = particle.position.x > maxP.x - cellSize * 1.2;
  const bool outOfTunnel = particle.position.y < origin.y + cellSize * 1.05 ||
                           particle.position.y > maxP.y - cellSize * 1.05 ||
                           particle.position.z < origin.z + cellSize * 1.05 ||
                           particle.position.z > maxP.z - cellSize * 1.05;
  if (particle.alpha < 0.0 || leftOutlet || outOfTunnel) {
    Respawn(particle, i);
  }
  tracers.particles[i] = particle;
}
