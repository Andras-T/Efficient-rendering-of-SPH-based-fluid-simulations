#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "SphPush.glsl"

layout(local_size_x = 256) in;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const uint n = pc.params.p.cellCount;
  if (i >= n) {
    return;
  }
  pc.offsets.data[i] += pc.blockSums.data[i / 256u];
}
