#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "Kernels.glsl"
#include "SphPush.glsl"

layout(local_size_x = 64) in;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const GpuSimParams p = pc.params.p;
  if (i >= p.particleCount) {
    return;
  }

  Particle self = pc.particles.particles[i];
  const ivec3 center = CellCoords(self.position, p);
  vec3 force = vec3(0.0);

  for (int z = -1; z <= 1; ++z) {
    for (int y = -1; y <= 1; ++y) {
      for (int x = -1; x <= 1; ++x) {
        const ivec3 cell = center + ivec3(x, y, z);
        if (any(lessThan(cell, ivec3(0))) || any(greaterThanEqual(cell, ivec3(p.gridSize)))) {
          continue;
        }
        const uint linear = CellIndex(cell, p);
        const uint begin = pc.offsets.data[linear];
        const uint end = begin + pc.counts.data[linear];
        for (uint j = begin; j < end; ++j) {
          if (j == i) {
            continue;
          }
          const Particle other = pc.particles.particles[j];
          const vec3 delta = self.position - other.position;
          const float distance = length(delta);
          const vec3 grad = SpikyGradient(delta, p.kernelRadius);
          const float pressureTerm = (self.pressure / (self.density * self.density)) +
                                     (other.pressure / (other.density * other.density));
          force -= other.mass * pressureTerm * grad;
          const float lap = ViscosityLaplacian(distance, p.kernelRadius);
          force += p.viscosity * other.mass * ((other.velocity - self.velocity) / other.density) * lap;
        }
      }
    }
  }

  self.force = force;
  pc.particles.particles[i] = self;
}
