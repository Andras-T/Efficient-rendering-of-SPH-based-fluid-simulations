#version 460
#extension GL_GOOGLE_include_directive : require

#include "Smoke.glsl"

layout(local_size_x = 64) in;

layout(push_constant, scalar) uniform PushConstants {
  VelocityRW velocitySrc;
  VelocityRW velocityDst;
  ScalarRW scalarSrc;
  ScalarRW scalarDst;
  PressureRW pressureSrc;
  PressureRW pressureDst;
  PressureRW divergence;
  uvec3 grid;
  uint cellCount;
  vec3 origin;
  float cellSize;
  float dt;
  float dissipation;
  float buoyancy;
  float vorticity;
  vec3 emitterCenter;
  float emitterRadius;
  float emitterDensity;
  float emitterTemperature;
};

float FetchPressure(uvec3 cell) {
  if (any(greaterThanEqual(cell, grid)) || SmokeIsWall(cell, grid)) {
    return 0.0;
  }
  return pressureSrc.values[SmokeCellIndex(cell, grid)];
}

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= cellCount) {
    return;
  }
  const uvec3 cell = SmokeCellCoord(i, grid);
  if (SmokeIsWall(cell, grid)) {
    pressureDst.values[i] = 0.0;
    return;
  }
  const ivec3 c = ivec3(cell);
  const float sum = FetchPressure(uvec3(c + ivec3(1, 0, 0))) + FetchPressure(uvec3(c + ivec3(-1, 0, 0))) +
                    FetchPressure(uvec3(c + ivec3(0, 1, 0))) + FetchPressure(uvec3(c + ivec3(0, -1, 0))) +
                    FetchPressure(uvec3(c + ivec3(0, 0, 1))) + FetchPressure(uvec3(c + ivec3(0, 0, -1)));
  pressureDst.values[i] = (sum - divergence.values[i] * cellSize * cellSize) / 6.0;
}
