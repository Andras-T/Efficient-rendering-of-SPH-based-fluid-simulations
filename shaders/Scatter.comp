#version 460
#extension GL_GOOGLE_include_directive : require

#include "Types.glsl"
#include "SphPush.glsl"

layout(local_size_x = 64) in;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const GpuSimParams p = pc.params.p;
  if (i >= p.particleCount) {
    return;
  }
  const uint slot = atomicAdd(pc.fill.data[pc.cellOf.data[i]], 1);
  pc.dest.data[i] = slot;
  pc.sorted.particles[slot] = pc.particles.particles[i];
}
